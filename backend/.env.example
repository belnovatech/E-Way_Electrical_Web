# Copy to backend/.env (or put these in <repo>/.env.local). Never commit real values.
APP_ENV=development
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/eway_db
JWT_SECRET=<long random string>
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Customer OTP: demo mode always uses DEMO_OTP and returns it in the response. Must be false in production.
OTP_DEMO_MODE=true
DEMO_OTP=123456
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=29

# Charging: simulate energy from charger power x time until chargers report meter values via /v1/ocpp.
CHARGING_SIMULATION=true
SIMULATION_SPEEDUP=1.0
OCPP_GATEWAY_KEY=<shared secret for the charger gateway>

PAYMENT_PROVIDER=sandbox
